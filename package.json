{
  "name": "chat-zap",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node ./node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "dev:server:watch": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs watch --exclude ./wwebjs_auth --exclude ./.wwebjs_cache --exclude ./node_modules --exclude ./src server/index.ts",
    "dev:fake": "concurrently -k \"npm:dev:server:fake\" \"npm:dev:web\"",
    "dev:server:fake": "node ./node_modules/tsx/dist/cli.mjs server/index.ts --fake"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "^6.7.21",
    "pino": "^9.9.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "whatsapp-web.js": "^1.34.2"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
